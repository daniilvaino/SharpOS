<Project>
  <!--
    Сборка win-x64 PE на НЕ-Windows хосте: ядро (OS/) и freestanding-приложения
    (apps_native/). На Windows файл ничего не делает.

    Это тулинг ЯДРА. Форк CoreCLR (dotnet-runtime-sharpos) — отдельная репа,
    C++ и CMake; его кросс-сборка это xwin + clang-cl /winsysroot + llvm-ml
    вместо ml64 + llvm-lib вместо lib.exe, и живёт она там, а не здесь.

    EFI следует Windows ABI, поэтому цель всегда win-x64 независимо от хоста.
    Проверено на macOS arm64: ILC компилирует кросс-платформенно без единой
    правки, весь вопрос был в сшивании.

    ПРЕДУСТАНОВКА (в дерево не тащим, как MSVC и MSYS2 — см. README):
      macOS : brew install lld
      Linux : apt install lld

    Заголовки и библиотеки MSVC здесь НЕ НУЖНЫ и лицензия VS Build Tools тоже:
    ядро NoStdLib, к Win32 не обращается, сшивается без import-библиотек.

    Механика совпадает с PublishAotCrossXWin (MIT, Aaron Robinson и Michal
    Strehovsky, github.com/Windows10CE/PublishAotCrossXWin) — пришли к одному
    независимо. Пакет здесь не подключён по двум причинам: он штатно включается
    только на Linux-хосте (Condition IsOSPlatform('Linux')), и он обязательно
    тянет sysroot от xwin с принятием лицензии Microsoft, что ядру не требуется.
    Когда дело дойдёт до форка — xwin берём там.

    Три рычага:
      DisableUnsupportedError   — снимает заслон "Cross-OS native compilation is
                                  not supported" в Microsoft.NETCore.Native.Publish.targets.
                                  Заслон декларативный: ILC targetos=windows умеет.
      IlcUseEnvironmentalTools  — отключает поиск MSVC через findvcvarsall.bat.
      CppLinker                 — lld-link вместо link.exe. Он понимает
                                  /SUBSYSTEM:EFI_APPLICATION и выдаёт корректный
                                  PE32+ с .pdata (проверено: 2944 записи раскрутки).

    Путь к lld-link переопределяется через -p:SharpOsLldLink=/путь/к/lld-link.
  -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <DisableUnsupportedError>true</DisableUnsupportedError>
    <IlcUseEnvironmentalTools>true</IlcUseEnvironmentalTools>
    <SharpOsLldLink Condition="'$(SharpOsLldLink)' == '' AND Exists('/opt/homebrew/opt/lld/bin/lld-link')">/opt/homebrew/opt/lld/bin/lld-link</SharpOsLldLink>
    <SharpOsLldLink Condition="'$(SharpOsLldLink)' == '' AND Exists('/usr/local/opt/lld/bin/lld-link')">/usr/local/opt/lld/bin/lld-link</SharpOsLldLink>
    <SharpOsLldLink Condition="'$(SharpOsLldLink)' == ''">lld-link</SharpOsLldLink>
  </PropertyGroup>

  <!--
    Сборка С ФОРКОМ. На Windows build_clr_sharpos.ps1 вливает libcmt.lib внутрь
    coreclr_static.lib (step 120), и ядру про неё знать не надо. На unix-хосте
    слияния нет: ни llvm-lib, ни lld-link /lib не переупаковывают libcmt —
    внутри есть объекты с машинным типом 0, LLVM их отвергает ("unknown
    machine: 0"), а lib.exe терпит. Как обычную библиотеку при сшивании
    lld-link её принимает, поэтому просто называем её здесь.

    Путь к sysroot: -p:SharpOsXwinSplat=<путь> либо переменная окружения
    SHARPOS_XWIN_SPLAT, либо .xwin-cache рядом с репозиторием.
  -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' AND '$(SkipCoreClr)' != 'true'">
    <SharpOsXwinSplat Condition="'$(SharpOsXwinSplat)' == ''">$(SHARPOS_XWIN_SPLAT)</SharpOsXwinSplat>
    <SharpOsXwinSplat Condition="'$(SharpOsXwinSplat)' == '' AND Exists('$(MSBuildThisFileDirectory).xwin-cache/splat/crt/lib/x64')">$(MSBuildThisFileDirectory).xwin-cache/splat</SharpOsXwinSplat>
  </PropertyGroup>

  <Target Name="SharpOsCrossHostLink"
          AfterTargets="SetupOSSpecificProps"
          BeforeTargets="LinkNative"
          Condition="'$(OS)' != 'Windows_NT'">
    <!-- CppLinker=link выставляется в Microsoft.NETCore.Native.Windows.targets,
         который импортируется ПОСЛЕ нас, поэтому подменять его надо здесь. -->
    <PropertyGroup>
      <CppLinker>$(SharpOsLldLink)</CppLinker>
    </PropertyGroup>
    <!-- Import-библиотеки Win32 снимаются ТОЛЬКО при сборке без форка: там ядро
         NoStdLib, к Win32 не обращается, и сшивание проходит без них. С форком
         они нужны по-настоящему — CoreCLR ссылается и на функции, и на данные
         вроде GUID'ов из uuid.lib, — поэтому оставляем их и даём пути к
         sysroot'у ниже. -->
    <ItemGroup Condition="'$(SkipCoreClr)' == 'true'">
      <!-- К этому моменту они уже запечены в LinkerArg как "kernel32.lib"
           и прочие — убирать надо сами аргументы. -->
      <LinkerArg Remove="&quot;advapi32.lib&quot;" />
      <LinkerArg Remove="&quot;bcrypt.lib&quot;" />
      <LinkerArg Remove="&quot;crypt32.lib&quot;" />
      <LinkerArg Remove="&quot;iphlpapi.lib&quot;" />
      <LinkerArg Remove="&quot;kernel32.lib&quot;" />
      <LinkerArg Remove="&quot;mswsock.lib&quot;" />
      <LinkerArg Remove="&quot;ncrypt.lib&quot;" />
      <LinkerArg Remove="&quot;normaliz.lib&quot;" />
      <LinkerArg Remove="&quot;ntdll.lib&quot;" />
      <LinkerArg Remove="&quot;ole32.lib&quot;" />
      <LinkerArg Remove="&quot;oleaut32.lib&quot;" />
      <LinkerArg Remove="&quot;secur32.lib&quot;" />
      <LinkerArg Remove="&quot;user32.lib&quot;" />
      <LinkerArg Remove="&quot;version.lib&quot;" />
      <LinkerArg Remove="&quot;ws2_32.lib&quot;" />
      <!-- Отладочная обвязка MSVC: natvis-визуализаторы и динамический ucrt. -->
      <LinkerArg Remove="/DEFAULTLIB:ucrt.lib" />
      <LinkerArg Remove="/DEBUG" />
      <LinkerArg Remove="@(LinkerArg)"
                 Condition="$([System.String]::Copy('%(Identity)').StartsWith('/NATVIS'))" />
    </ItemGroup>
    <ItemGroup Condition="'$(SkipCoreClr)' != 'true'">
      <LinkerArg Include="/LIBPATH:$(SharpOsXwinSplat)/crt/lib/x64" />
      <LinkerArg Include="/LIBPATH:$(SharpOsXwinSplat)/sdk/lib/um/x64" />
      <LinkerArg Include="/LIBPATH:$(SharpOsXwinSplat)/sdk/lib/ucrt/x64" />
      <LinkerArg Include="libcmt.lib" />
    </ItemGroup>
    <Error Condition="'$(SkipCoreClr)' != 'true' AND '$(SharpOsXwinSplat)' == ''"
           Text="Сборка с форком на unix-хосте требует sysroot от xwin: задайте -p:SharpOsXwinSplat=&lt;путь&gt; или SHARPOS_XWIN_SPLAT. Без него не найдётся libcmt.lib." />
    <Message Importance="normal"
             Text="SharpOS: кросс-хост сшивание через $(CppLinker) (хост $(OS), цель win-x64)" />
  </Target>
</Project>
