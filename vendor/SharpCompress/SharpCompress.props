<Project>

  <!-- SharpCompress (Adam Hathcock, MIT) for an app: every format it reads and
       writes, all managed, as the library assembly
       std-no-runtime/Libraries/SharpCompress — built from src/ here, with
       System.IO.Compression over it (BCL's DeflateStream, GZipStream,
       ZLibStream, ZipArchive and ZipFile from std-no-runtime/IO/Compression,
       whose zlib is SharpCompress's). What is taken and what is changed, and
       why: PROVENANCE.md. Opt-in: 164 000 lines are not what every app needs.
       App tier only: ZipFile needs File and Directory. -->

  <Import Project="$(MSBuildThisFileDirectory)../../std-no-runtime/Text/RegularExpressions/Regex.props" />
  <Import Project="$(MSBuildThisFileDirectory)../../std-no-runtime/Text/CodePages/CodePages.props" />

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\std-no-runtime\Libraries\SharpCompress\SharpCompress.csproj" />
  </ItemGroup>

</Project>
