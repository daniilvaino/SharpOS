<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- The parser and ReadingBuffer are unsafe. This used to be set per
         Configuration|Platform for AnyCPU only, so any build with an explicit RID (a
         NativeAOT publish, for instance) failed with CS0227. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Utils\" />
    <Folder Include="Renderer\" />
    <Folder Include="InputHandlers\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Renderer.cs" />
  </ItemGroup>
    
  <ItemGroup>
    <!-- Visible="False" is item metadata, but modern SDKs feed every metadata entry to the
         attribute constructor, so this used to emit InternalsVisibleTo("Tests", Visible)
         and fail to compile. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>    
</Project>
