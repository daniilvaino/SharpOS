<Project>

  <!-- System.Xml's reader from the fork (dotnet-runtime-sharpos, .NET 10):
       XmlReader, XmlTextReader, XmlReaderSettings, NameTable,
       XmlNamespaceManager, XmlConvert. No DTD, schemas, XSLT, DOM or
       XmlWriter. What is cut and why: README.md beside this.

       Opt-in rather than in Std.App.props, like Regex.props. App tier only. -->

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);SHARPOS_XML</DefineConstants>
    <!-- CS8500: dotnet/runtime builds every library with it off (Directory.Build.props). -->
    <NoWarn>$(NoWarn);CS8500</NoWarn>
  </PropertyGroup>

  <!-- XmlConvert.EncodeName/DecodeName take their patterns by [GeneratedRegex],
       as upstream. -->
  <Import Project="$(MSBuildThisFileDirectory)../Text/RegularExpressions/Regex.props" />

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)**\*.cs" Link="std\Xml\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
