<Project>

  <!-- System.Xml's reader for an app: the library assembly
       (std-no-runtime/Libraries/System.Private.Xml, built from the sources
       here — the fork's .NET 10 XmlReader, XmlTextReader, XmlReaderSettings,
       NameTable, XmlNamespaceManager, XmlConvert; no DTD, schemas, XSLT, DOM or
       XmlWriter; what is cut and why: README.md beside this).

       Opt-in rather than in CoreLib, like Regex.props. App tier only. -->

  <Import Project="$(MSBuildThisFileDirectory)../Text/RegularExpressions/Regex.props" />

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Libraries\System.Private.Xml\System.Private.Xml.csproj" />
  </ItemGroup>

</Project>
