<!--
  std-no-runtime: ярусная часть ядра.

  Реализации, которые у ядра свои. У каждой есть пара в Std.App.props —
  одно и то же, сделанное по-разному, потому что ярусы разные.

  Берёт CoreLib ядра (CoreLib.Kernel/CoreLib.Kernel.csproj). Пути относительно
  этого файла. Правило и таблица ярусных пар — в README.md рядом.
-->
<Project>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)GC\GcMemorySource.KernelHeap.cs" Link="std\GC\GcMemorySource.KernelHeap.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Pipes\PipeTransport.KernelPipes.cs" Link="std\Pipes\PipeTransport.KernelPipes.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)EnvironmentStore.Kernel.cs" Link="std\EnvironmentStore.Kernel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Runtime\Array.Empty.Kernel.cs" Link="std\Runtime\Array.Empty.Kernel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Runtime\Diagnostics.Output.KernelConsole.cs" Link="std\Runtime\Diagnostics.Output.KernelConsole.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)StringRuntime.KernelHeap.cs" Link="std\StringRuntime.KernelHeap.cs" />
    <!-- What the kernel tier needs from the kernel, installed by it at boot. -->
    <Compile Include="$(MSBuildThisFileDirectory)Runtime\KernelServices.cs" Link="std\Runtime\KernelServices.cs" />
    <!-- The core types and the helpers ILC looks up by name in the system module. -->
    <Compile Include="$(MSBuildThisFileDirectory)Runtime\MinimalRuntime.Kernel.cs" Link="std\Runtime\MinimalRuntime.Kernel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Runtime\ThrowHelpers.Kernel.cs" Link="std\Runtime\ThrowHelpers.Kernel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Runtime\CoreLibFriends.Kernel.cs" Link="std\Runtime\CoreLibFriends.Kernel.cs" />
  </ItemGroup>
</Project>
