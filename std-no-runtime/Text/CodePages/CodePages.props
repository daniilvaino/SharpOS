<Project>

  <!-- System.Text.Encoding.CodePages for an app: the library assembly
       (std-no-runtime/Libraries/System.Text.Encoding.CodePages, built from the
       sources here — dotnet/runtime v8.0.27: every code page .NET knows —
       Windows-125x, DOS (437, 866), ISO-8859-x, KOI8, Shift-JIS, GB18030, EUC,
       ISO-2022, ISCII — through CodePagesEncodingProvider; codepages.nlp
       (612 KB) embedded under its upstream name. What is changed and why:
       README.md beside this).

       Opt-in, app tier: the table is 612 KB of every image that takes it. -->

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Libraries\System.Text.Encoding.CodePages\System.Text.Encoding.CodePages.csproj" />
  </ItemGroup>

</Project>
