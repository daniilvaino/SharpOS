<Project>

  <!-- System.Text.RegularExpressions for an app: the library assembly
       (std-no-runtime/Libraries/System.Text.RegularExpressions, built from the
       sources here — the fork's .NET 10 interpreter and NonBacktracking; what
       is cut and why: README.md beside this) and the [GeneratedRegex] source
       generator for the app's own code: the .NET 10 targeting pack's, the
       library's version (Libraries/PackGenerators.props); the net8.0 pack's
       knows no [GeneratedRegex] on a partial property (.NET 9), which the
       fork's sources and vendored code use.

       Opt-in rather than in CoreLib, like Json.props. App tier only. -->

  <PropertyGroup>
    <SharpOsRegexGenerator>true</SharpOsRegexGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Libraries\System.Text.RegularExpressions\System.Text.RegularExpressions.csproj" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Libraries\PackGenerators.props" />

</Project>
