<Project>

  <!-- System.Text.RegularExpressions from the fork (dotnet-runtime-sharpos,
       .NET 10): the interpreter and NonBacktracking. RegexOptions.Compiled
       runs on the interpreter, as upstream does where dynamic code is not
       supported. What is cut and why: README.md beside this.

       Opt-in rather than in Std.App.props, like Json.props. App tier only. -->

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);SHARPOS_REGEX;SYSTEM_TEXT_REGULAREXPRESSIONS</DefineConstants>
    <!-- CS8500 (pointer to a managed type, ReadOnlySpan<int>* in RegexReplacement): dotnet/runtime builds every library with it off (Directory.Build.props). -->
    <NoWarn>$(NoWarn);CS8500</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)**\*.cs" Link="std\Text\RegularExpressions\%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\generators\Regex.Generator\Regex.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- [GeneratedRegex] through our generator (generators/Regex.Generator): the
       targeting pack's comes with every app and writes `protected override`,
       which does not compile against the library in the same assembly. -->
  <Target Name="_SharpOsRegexGeneratorOnly" BeforeTargets="CoreCompile" AfterTargets="ResolvePackageFileConflicts">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'System.Text.RegularExpressions.Generator'" />
    </ItemGroup>
  </Target>

</Project>
