<Project>

  <!-- System.Text.Json for an app: the library assembly
       (std-no-runtime/Libraries/System.Text.Json, built from the sources here
       with System.Text.Encodings.Web and System.IO.Pipelines — the fork's .NET
       10, whole: reader, writer, JsonDocument, JsonNode, JsonSerializer; what
       is cut and why: README.md beside this).

       JsonSerializer works through the source generator: JsonSerializerContext
       ([JsonSerializable]) gives every type its JsonTypeInfo. The generator is
       the .NET 10 targeting pack's, the library's version
       (Libraries/PackGenerators.props): it knows the attributes by the
       assembly name System.Text.Json, and the library is that assembly.

       Opt-in rather than in CoreLib: 400 files are not what every app needs.
       App tier only. -->

  <PropertyGroup>
    <SharpOsJsonGenerator>true</SharpOsJsonGenerator>
  </PropertyGroup>

  <!-- STJ uses Regex, as upstream does. -->
  <Import Project="$(MSBuildThisFileDirectory)../RegularExpressions/Regex.props" />

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Libraries\System.Text.Json\System.Text.Json.csproj" />
  </ItemGroup>

</Project>
