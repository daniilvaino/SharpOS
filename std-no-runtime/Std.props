<!--
  std-no-runtime: общая часть. Берут оба яруса.

  Всё, что одинаково для ядра и приложений. Новый файл в std-no-runtime
  попадает сюда, если у него нет ярусной пары.

  Пути относительно этого файла, поэтому список одинаково читается и из
  OS/OS.csproj, и из apps_native/sdk/FreestandingPe.props. Правило и таблица
  ярусных пар — в README.md рядом.
-->
<Project>
  <!-- Source generators every image runs (generators/SharpOS.Generators):
       the kernel and each app import this file, so this is the one place that
       reaches all of them. -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\generators\SharpOS.Generators\SharpOS.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
