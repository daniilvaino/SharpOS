<!--
  std-no-runtime: общая часть. Берут оба яруса.

  Всё, что одинаково для ядра и приложений. Новый файл в std-no-runtime
  попадает сюда, если у него нет ярусной пары.

  Пути относительно этого файла, поэтому список одинаково читается и из
  OS/OS.csproj, и из apps_native/sdk/FreestandingPe.props. Правило и таблица
  ярусных пар — в README.md рядом.
-->
<Project>
  <!-- SharpLibm (../SharpLibm, submodule): the C math library in C# that
       System.Math / MathF and the `%` helpers sit on (step198). Its sources
       compile into each image; ILC keeps only the functions used. -->
  <Import Project="$(MSBuildThisFileDirectory)..\SharpLibm\SharpLibm.props" />

  <!-- TurboXml (vendor/TurboXml, BSD-2-Clause): SAX XML parsing on both tiers. -->
  <Import Project="$(MSBuildThisFileDirectory)..\vendor\TurboXml\TurboXml.props" />

  <!-- Source generators every image runs (generators/): the kernel and each
       app import this file, so this is the one place that reaches all of
       them. ImageInfo — which image this is; Pipes — [Message] catalog and
       Region<T> rules; Dynamic — call-site thunks and member tables of
       `dynamic`, SOSD rules. -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\generators\ImageInfo.Generator\ImageInfo.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\generators\Pipes.Generator\Pipes.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\generators\Dynamic.Generator\Dynamic.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Bcl\ArraySegment.cs" Link="std\Bcl\ArraySegment.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Bcl\BinaryPrimitives.ReadBigEndian.cs" Link="std\Bcl\BinaryPrimitives.ReadBigEndian.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Bcl\BinaryPrimitives.ReadLittleEndian.cs" Link="std\Bcl\BinaryPrimitives.ReadLittleEndian.cs" />
