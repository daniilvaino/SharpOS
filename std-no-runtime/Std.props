  <!-- `dynamic`: every CallSite<T> the compiler emitted has a thunk the
       generator wrote (generators/Dynamic.Check). Runs on the compiled IL,
       before ILC; a miss fails the build with SOSD100. -->
  <Target Name="SharpOsDynamicCheck" AfterTargets="CoreCompile" Condition="'$(SharpOsDynamicCheck)' != 'false'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\generators\Dynamic.Check\Dynamic.Check.csproj" Targets="Build"
             Properties="Configuration=Release"
             RemoveProperties="RuntimeIdentifier;Platform;TargetFramework;SelfContained;PublishAot;_IsPublishing;Optimize;DebugType" />
    <PropertyGroup>
      <_SharpOsDotnet>$(DOTNET_HOST_PATH)</_SharpOsDotnet>
      <_SharpOsDotnet Condition="'$(_SharpOsDotnet)' == ''">dotnet</_SharpOsDotnet>
    </PropertyGroup>
    <Exec Command="&quot;$(_SharpOsDotnet)&quot; &quot;$(MSBuildThisFileDirectory)..\generators\Dynamic.Check\bin\Release\net8.0\Dynamic.Check.dll&quot; &quot;@(IntermediateAssembly->'%(FullPath)')&quot;" />
  </Target>
</Project>
