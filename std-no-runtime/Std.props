    <Compile Include="$(MSBuildThisFileDirectory)Bcl\Hashtable.cs" Link="std\Bcl\Hashtable.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Bcl\CompatibleComparer.cs" Link="std\Bcl\CompatibleComparer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Bcl\IHashCodeProvider.cs" Link="std\Bcl\IHashCodeProvider.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Bcl\DebugViewDictionaryItem.cs" Link="std\Bcl\DebugViewDictionaryItem.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Bcl\Obsoletions.cs" Link="std\Bcl\Obsoletions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Bcl\SR.Hashtable.cs" Link="std\Bcl\SR.Hashtable.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Globalization\IdnMapping.cs" Link="std\Globalization\IdnMapping.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Globalization\SR.IdnMapping.cs" Link="std\Globalization\SR.IdnMapping.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Runtime\MemoryExtensions.SearchValues.cs" Link="std\Runtime\MemoryExtensions.SearchValues.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Runtime\MemoryExtensions.Overlaps.cs" Link="std\Runtime\MemoryExtensions.Overlaps.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Runtime\SR.MemoryExtensions.cs" Link="std\Runtime\SR.MemoryExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Text\Ascii.cs" Link="std\Text\Ascii.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Text\SpanRuneEnumerator.cs" Link="std\Text\SpanRuneEnumerator.cs" />
  </ItemGroup>
  <!-- `dynamic`: every CallSite<T> the compiler emitted has a thunk the
       generator wrote (generators/Dynamic.Check). Runs on the compiled IL,
       before ILC; a miss fails the build with SOSD100. -->
  <Target Name="SharpOsDynamicCheck" AfterTargets="CoreCompile" Condition="'$(SharpOsDynamicCheck)' != 'false'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\generators\Dynamic.Check\Dynamic.Check.csproj" Targets="Build"
             Properties="Configuration=Release"
             RemoveProperties="RuntimeIdentifier;Platform;TargetFramework;SelfContained;PublishAot;_IsPublishing;Optimize;DebugType" />
    <PropertyGroup>
      <_SharpOsDotnet>$(DOTNET_HOST_PATH)</_SharpOsDotnet>
      <_SharpOsDotnet Condition="'$(_SharpOsDotnet)' == ''">dotnet</_SharpOsDotnet>
    </PropertyGroup>
    <Exec Command="&quot;$(_SharpOsDotnet)&quot; &quot;$(MSBuildThisFileDirectory)..\generators\Dynamic.Check\bin\Release\net8.0\Dynamic.Check.dll&quot; &quot;@(IntermediateAssembly->'%(FullPath)')&quot;" />
  </Target>
</Project>
