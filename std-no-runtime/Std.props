    <Compile Include="$(MSBuildThisFileDirectory)Runtime\UnboxHelpers.cs" Link="std\Runtime\UnboxHelpers.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Runtime\MathHelpers.cs" Link="std\Runtime\MathHelpers.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Runtime\Unsafe.cs" Link="std\Runtime\Unsafe.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Runtime\ValueTuple.cs" Link="std\Runtime\ValueTuple.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Security\Sha256.cs" Link="std\Security\Sha256.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)StringAlgorithms.cs" Link="std\StringAlgorithms.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)StringComparer.cs" Link="std\StringComparer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)StringComparison.cs" Link="std\StringComparison.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)StringFormat.cs" Link="std\StringFormat.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)StringManipulation.cs" Link="std\StringManipulation.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)StringQueries.cs" Link="std\StringQueries.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)StringSplitOptions.cs" Link="std\StringSplitOptions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)StringTransforms.cs" Link="std\StringTransforms.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)SynchronizationContext.cs" Link="std\SynchronizationContext.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)SystemString.Enumerator.cs" Link="std\SystemString.Enumerator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)SystemString.Span.cs" Link="std\SystemString.Span.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)SystemString.cs" Link="std\SystemString.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Text\Encoding.cs" Link="std\Text\Encoding.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Text\FallbackExceptions.cs" Link="std\Text\FallbackExceptions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Text\StringBuilder.cs" Link="std\Text\StringBuilder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Threading.Atomics.cs" Link="std\Threading.Atomics.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Threading.ManagedThreadId.cs" Link="std\Threading.ManagedThreadId.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Threading.Monitor.cs" Link="std\Threading.Monitor.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Threading.Tasks.Await.cs" Link="std\Threading.Tasks.Await.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Threading.Tasks.cs" Link="std\Threading.Tasks.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Threading.Thread.cs" Link="std\Threading.Thread.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Threading.cs" Link="std\Threading.cs" />
  </ItemGroup>
  <!-- `dynamic`: every CallSite<T> the compiler emitted has a thunk the
       generator wrote (generators/Dynamic.Check). Runs on the compiled IL,
       before ILC; a miss fails the build with SOSD100. -->
  <Target Name="SharpOsDynamicCheck" AfterTargets="CoreCompile" Condition="'$(SharpOsDynamicCheck)' != 'false'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\generators\Dynamic.Check\Dynamic.Check.csproj" Targets="Build"
             Properties="Configuration=Release"
             RemoveProperties="RuntimeIdentifier;Platform;TargetFramework;SelfContained;PublishAot;_IsPublishing;Optimize;DebugType" />
    <PropertyGroup>
      <_SharpOsDotnet>$(DOTNET_HOST_PATH)</_SharpOsDotnet>
      <_SharpOsDotnet Condition="'$(_SharpOsDotnet)' == ''">dotnet</_SharpOsDotnet>
    </PropertyGroup>
    <Exec Command="&quot;$(_SharpOsDotnet)&quot; &quot;$(MSBuildThisFileDirectory)..\generators\Dynamic.Check\bin\Release\net8.0\Dynamic.Check.dll&quot; &quot;@(IntermediateAssembly->'%(FullPath)')&quot;" />
  </Target>
</Project>
