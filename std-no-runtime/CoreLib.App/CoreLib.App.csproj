<Project Sdk="Microsoft.NET.Sdk">

  <!-- System.Private.CoreLib for apps: std (Std.props), its app tier
       (Std.App.props) and the SDK's runtime half — the service table, startup,
       File/Path/Environment/Console/Process over it
       (apps_native/sdk/SdkRuntime.props). One for every app: an app is built
       over it (and over SharpOS.AppSdk), as a stock program over the stock
       CoreLib. Its sibling for the kernel is ../CoreLib.Kernel. -->

  <PropertyGroup>
    <AssemblyName>System.Private.CoreLib</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>annotations</Nullable>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <RuntimeMetadataVersion>v4.0.30319</RuntimeMetadataVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <Import Project="..\Std.props" />
  <Import Project="..\Std.App.props" />
  <Import Project="..\..\apps_native\sdk\SdkRuntime.props" />

  <!-- The SDK adds framework references; this assembly is the framework. -->
  <Target Name="CustomizeReferences" BeforeTargets="BeforeCompile" AfterTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" />
      <ReferencePath Remove="@(ReferencePath)" />
    </ItemGroup>
  </Target>

</Project>
