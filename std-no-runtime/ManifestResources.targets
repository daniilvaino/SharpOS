<Project>

  <!-- Manifest resources of an app, as data in the image.

       ILC puts a module's manifest resources into the image only when the
       module has reflection metadata (ResourceDataNode walks
       GetCompilationModulesWithMetadata), and an app here has none: every
       <EmbeddedResource> was silently left out (step226 — CodePages'
       codepages.nlp, Okojo's Intl data). This turns each one (not .resx,
       which GenerateResource handles) into a ReadOnlySpan<byte> property —
       C# compiles `new byte[] { constants }` behind it into a data blob — and
       a lookup Assembly.GetManifestResourceStream asks (std
       Runtime/Reflection.Assembly.cs, ImageAssembly.FindEmbedded). Names are
       the resource's LogicalName, else its ManifestResourceName, as the BCL
       sees them. -->

  <UsingTask TaskName="SharpOsEmbedResources" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Resources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var sb = new StringBuilder();
        sb.Append("// <auto-generated/> by std-no-runtime/ManifestResources.targets\n");
        sb.Append("namespace System.Reflection\n{\n    internal sealed partial class ImageAssembly\n    {\n");
        var names = new StringBuilder();
        var cases = new StringBuilder();
        var blobs = new StringBuilder();
        int n = 0;
        foreach (var item in Resources)
        {
            string path = item.GetMetadata("FullPath");
            if (path.EndsWith(".resx", StringComparison.OrdinalIgnoreCase)) continue;
            string name = item.GetMetadata("LogicalName");
            if (string.IsNullOrEmpty(name)) name = item.GetMetadata("ManifestResourceName");
            if (string.IsNullOrEmpty(name)) name = Path.GetFileName(path);
            string literal = "\"" + name.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
            names.Append("            names.Add(").Append(literal).Append(");\n");
            cases.Append("                case ").Append(literal).Append(": data = R").Append(n).Append("; found = true; return;\n");
            byte[] bytes = File.ReadAllBytes(path);
            blobs.Append("        private static ReadOnlySpan<byte> R").Append(n).Append(" => new byte[] {");
            for (int i = 0; i < bytes.Length; i++)
            {
                if ((i & 31) == 0) blobs.Append("\n            ");
                blobs.Append(bytes[i]).Append(',');
            }
            blobs.Append("\n        };\n\n");
            n++;
        }
        sb.Append("        static partial void EmbeddedNames(System.Collections.Generic.List<string> names)\n        {\n").Append(names).Append("        }\n\n");
        sb.Append("        static partial void FindEmbedded(string name, ref ReadOnlySpan<byte> data, ref bool found)\n        {\n            switch (name)\n            {\n").Append(cases).Append("            }\n        }\n\n");
        sb.Append(blobs);
        sb.Append("    }\n}\n");
        string text = sb.ToString();
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text)
            File.WriteAllText(OutputFile, text);
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_SharpOsEmbedResources"
          AfterTargets="PrepareResourceNames"
          BeforeTargets="CoreCompile"
          Condition="'@(EmbeddedResource)' != ''">
    <SharpOsEmbedResources Resources="@(EmbeddedResource)"
                           OutputFile="$(MSBuildProjectDirectory)\obj\SharpOsResources.g.cs" />
    <ItemGroup>
      <Compile Include="$(MSBuildProjectDirectory)\obj\SharpOsResources.g.cs" />
    </ItemGroup>
  </Target>

</Project>
