<Project Sdk="Microsoft.NET.Sdk">

  <!-- System.Text.RegularExpressions from the fork (.NET 10): the interpreter
       and NonBacktracking; RegexOptions.Compiled runs on the interpreter, as
       upstream does where dynamic code is not supported. Sources and what is
       cut: std-no-runtime/Text/RegularExpressions (README.md). An app takes it
       through Regex.props there. -->

  <PropertyGroup>
    <AssemblyName>System.Text.RegularExpressions</AssemblyName>
    <DefineConstants>$(DefineConstants);SHARPOS_REGEX;SYSTEM_TEXT_REGULAREXPRESSIONS</DefineConstants>
    <!-- CS8500 (pointer to a managed type, ReadOnlySpan<int>* in RegexReplacement): dotnet/runtime builds every library with it off (Directory.Build.props). -->
    <NoWarn>$(NoWarn);CS8500</NoWarn>
  </PropertyGroup>

  <Import Project="..\Library.props" />

  <ItemGroup>
    <Compile Include="..\..\Text\RegularExpressions\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
