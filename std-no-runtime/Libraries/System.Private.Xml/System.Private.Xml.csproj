<Project Sdk="Microsoft.NET.Sdk">

  <!-- System.Xml's reader from the fork (.NET 10): XmlReader, XmlTextReader,
       XmlReaderSettings, NameTable, XmlNamespaceManager, XmlConvert. Sources and
       what is cut: std-no-runtime/Xml (README.md). An app takes it through
       Xml.props there. -->

  <PropertyGroup>
    <AssemblyName>System.Private.Xml</AssemblyName>
    <DefineConstants>$(DefineConstants);SHARPOS_XML</DefineConstants>
    <!-- CS8500: dotnet/runtime builds every library with it off (Directory.Build.props). -->
    <NoWarn>$(NoWarn);CS8500</NoWarn>
  </PropertyGroup>

  <Import Project="..\Library.props" />

  <ItemGroup>
    <Compile Include="..\..\Xml\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- XmlConvert.EncodeName/DecodeName take their patterns by [GeneratedRegex], as upstream. -->
  <Import Project="..\..\Text\RegularExpressions\Regex.props" />

</Project>
