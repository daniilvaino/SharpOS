<Project Sdk="Microsoft.NET.Sdk">

  <!-- System.Text.RegularExpressions' source generator ([GeneratedRegex]), built
       here from the fork's sources (dotnet-runtime-sharpos, .NET 10; src/ is a
       copy, MIT) instead of the SDK's: the library is compiled into each app
       (std-no-runtime/Text/RegularExpressions), so the generated runner overrides
       protected internal members of its own assembly and must say `protected
       internal`. That is the one edit, marked "SharpOS:" in
       src/RegexGenerator.Emitter.cs. What else differs: PROVENANCE.md.

       netstandard2.0 is what the Roslyn analyzer host loads. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Not System.Text.RegularExpressions.Generator: the SDK resolves analyzers
         of the same file name to one, and keeps the targeting pack's. -->
    <AssemblyName>SharpOS.Regex.Generator</AssemblyName>
    <RootNamespace>System.Text.RegularExpressions.Generator</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <!-- Upstream's NoWarn (CS0436 CS0649 CA1872; CS8500 from dotnet/runtime's
         Directory.Build.props), and nullable off for netstandard2.0, where the
         BCL has no annotations. -->
    <NoWarn>$(NoWarn);CS0436;CS0649;CA1872;CS8500;nullable</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Compile Include="SR.cs" />
    <EmbeddedResource Include="Resources\Strings.resx" LogicalName="FxResources.System.Text.RegularExpressions.Generator.SR.resources" />
  </ItemGroup>

</Project>
