<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host-side checks of the pipe analyzers and the [Message] generator
       (pipe test 12): each rule against an example that must trip it, and
       correct code that must stay silent. Runs on the build host:
       `dotnet run -c Release` here. Not part of any image. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <ProjectReference Include="..\SharpOS.Generators\SharpOS.Generators.csproj" />
  </ItemGroup>

</Project>
