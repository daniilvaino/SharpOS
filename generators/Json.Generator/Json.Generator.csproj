<Project Sdk="Microsoft.NET.Sdk">

  <!-- System.Text.Json's source generator, built here from the fork's sources
       (dotnet-runtime-sharpos, .NET 10; src/ is a copy, MIT) instead of the
       SDK's: System.Text.Json is compiled into each app (std-no-runtime/Text/
       Json), and the SDK's generator recognises member attributes only by the
       assembly name "System.Text.Json". The one edit is marked "SharpOS:" in
       src/JsonSourceGenerator.Parser.cs. What else differs: PROVENANCE.md.

       netstandard2.0 is what the Roslyn analyzer host loads. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Not System.Text.Json.SourceGeneration: the SDK resolves analyzers of the
         same file name to one, and keeps the targeting pack's. -->
    <AssemblyName>SharpOS.Json.Generator</AssemblyName>
    <RootNamespace>System.Text.Json.SourceGeneration</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <DefineConstants>$(DefineConstants);BUILDING_SOURCE_GENERATOR;ROSLYN4_0_OR_GREATER;ROSLYN4_4_OR_GREATER</DefineConstants>
    <!-- Upstream's: unresolved crefs in shared sources, release tracking, and
         nullable off for netstandard2.0 (System.Text.Json.SourceGeneration.targets). -->
    <NoWarn>$(NoWarn);CS1574;RS2008;RS1036;nullable</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Compile Include="SR.cs" />
    <EmbeddedResource Include="Resources\Strings.resx" LogicalName="FxResources.System.Text.Json.SourceGeneration.SR.resources" />
  </ItemGroup>

</Project>
