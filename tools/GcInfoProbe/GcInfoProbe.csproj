<Project Sdk="Microsoft.NET.Sdk">
  <!-- Decode a method's GcInfo on the build host with the kernel's own decoder (step193): which slots are live at each call site. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\OS\src\Boot\EH\BitReader.cs" />
    <Compile Include="..\..\OS\src\Boot\EH\CoffGcInfoDecoder.cs" />
    <Compile Include="..\..\OS\src\Boot\EH\CoffGcInfoTypes.cs" />
  </ItemGroup>
</Project>
