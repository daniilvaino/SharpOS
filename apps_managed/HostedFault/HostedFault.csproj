<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built three times by run_build.ps1, as HostedFailFast, HostedThrow and
       HostedExit: the shell passes no arguments to a .DLL, so the assembly's
       name picks the case. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName Condition="'$(AssemblyName)' == ''">HostedFailFast</AssemblyName>
    <BaseOutputPath>bin\$(AssemblyName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
