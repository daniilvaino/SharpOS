<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IlcSystemModule>TuiProbe</IlcSystemModule>
    <!-- C# 14 for extension members: RuneCount and ConsoleWidth read as
         properties on string at 54 call sites, exactly as they read on ustring
         before, so the library keeps its own phrasing. -->
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <!-- Same freestanding win-x64 PE recipe every AOT app uses, so whatever this
       finds transfers to a real app unchanged. -->
  <Import Project="..\sdk\FreestandingPe.props" />

  <!-- The library, its file list, and the reasoning behind every exclusion.
       Shared with Tui1 so the two cannot drift. -->
  <Import Project="..\..\vendor\Terminal.Gui\TerminalGui.props" />

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
