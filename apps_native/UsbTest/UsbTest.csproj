<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A bench for the rig's hardware, started by hand: not on the image (tools/Apps.ps1). -->
    <SharpOsCategory>none</SharpOsCategory>
    <!-- C# 14: the library's RuneCount / ConsoleWidth are extension properties.
         See vendor/Terminal.Gui/TerminalGui.props. -->
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <!-- The freestanding win-x64 PE recipe every AOT app uses. -->
  <Import Project="..\sdk\FreestandingPe.props" />

  <!-- Terminal.Gui, its file list and every exclusion, shared with the launcher. -->
  <Import Project="..\..\vendor\Terminal.Gui\TerminalGui.props" />

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Format.cs" />
    <Compile Include="UsbSnapshot.cs" />
    <Compile Include="BusTab.cs" />
    <Compile Include="KeyTab.cs" />
    <Compile Include="CtapInfo.cs" />
    <Compile Include="CtapCredential.cs" />
  </ItemGroup>
</Project>
