<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IlcSystemModule>Json2Dir</IlcSystemModule>
    <!-- Two Mains: json2dir's takes string[], which ILC cannot start a
         freestanding image with — the C# entry point is AppEntry's. The
         kernel enters through SharpAppEntry (Entry.cs). -->
    <StartupObject>AppEntry</StartupObject>
    <!-- json2dir is written for nullable reference types. -->
    <Nullable>annotations</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- The freestanding win-x64 PE recipe every AOT app uses. -->
  <Import Project="..\sdk\FreestandingPe.props" />

  <ItemGroup>
    <Compile Include="Entry.cs" />
    <!-- json2dir (MIT), vendor/json2dir: PROVENANCE.md says what was cut for FAT. -->
    <Compile Include="..\..\vendor\json2dir\src\Program.cs" Link="json2dir\Program.cs" />
    <Compile Include="..\..\vendor\json2dir\src\Json.cs" Link="json2dir\Json.cs" />
  </ItemGroup>
</Project>
