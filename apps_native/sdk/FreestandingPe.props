<Project>

  <!-- Сшивание PE через lld-link + xwin из тулчейна SharpOS, на любом хосте. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\SharpOsNativeLink.props" />

  <!-- Shared freestanding win-x64 PE recipe for SharpOS native apps (step138).
       Imported by each app csproj (HelloSharpFs, FetchApp, AotTests, ...). Turns
       `dotnet publish -r win-x64` into a self-contained PE the kernel's PeLoader
       maps + jumps (see done/step137.md). ELF (linux-x64) builds are gone; this
       is win-x64 only, gated on the RID so a non-win-x64 evaluation is a no-op.

       The app csproj keeps only what differs: IlcSystemModule (per-app corelib
       name) and its own Program.cs / app-specific sources. -->

  <PropertyGroup>
    <!-- net8/ILC8 (matches the kernel / major-9 GC layout). -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <!-- The kernel's language version. net8 would otherwise default apps to
         C# 12 while the std they compile is written against 14, and code
         generated for every image (generators/ImageInfo.Generator, generators/Pipes.Generator) has to
         compile in both. -->
    <LangVersion Condition="'$(LangVersion)' == ''">14.0</LangVersion>
    <!-- Unconditional: Sdk.props already defaulted OutputType to Library before
         this import, so a `== ''` guard would leave it Library and NativeAOT
         would link bootstrapperdll.obj (the DLL runtime bootstrap) which our
         ExcludeNativeAotRuntime (bootstrapper.obj, the EXE one) doesn't strip. -->
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <RuntimeMetadataVersion>v4.0.30319</RuntimeMetadataVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PublishAot>true</PublishAot>
    <EntryPointSymbol>SharpAppEntry</EntryPointSymbol>

    <!-- net8/ILC8: DebuggerSupport (default on) exports DotNetRuntimeDebugHeader
         (unresolved / LNK1294); no debugger attaches to a freestanding app.
         IlcDehydrate (default on) compresses data + relies on the stock
         bootstrapper to rehydrate at startup, which we exclude below, so bake
         data in directly, else string literals read back as zeros. -->
    <DebuggerSupport>false</DebuggerSupport>
    <IlcDehydrate>false</IlcDehydrate>
  </PropertyGroup>

  <!-- Base app SDK + std surface shared by every native app. sdk/* are next to
       this .props ($(MSBuildThisFileDirectory)); std/* are two levels up. The
       app csproj adds only its Program.cs and any app-specific extras (e.g. a
       richer std slice for the test battery). -->
  <!-- std-no-runtime: общая часть плюс ярусная часть приложений. Списка ровно
       три, правило и таблица ярусных пар — в std-no-runtime/README.md. Здесь
       остаётся только SDK приложений: то, что знает про таблицу служб и
       контракты процесса. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\std-no-runtime\Std.props" />
  <Import Project="$(MSBuildThisFileDirectory)..\..\std-no-runtime\Std.App.props" />

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)MinimalRuntime.cs"       Link="sdk\MinimalRuntime.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AppStartupBlock.cs"      Link="sdk\AppStartupBlock.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AppServiceTable.cs"      Link="sdk\AppServiceTable.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AppRuntime.cs"           Link="sdk\AppRuntime.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AppThreads.cs"           Link="sdk\AppThreads.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AppConsole.cs"           Link="sdk\AppConsole.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AppGC.cs"                Link="sdk\AppGC.cs" />
    <!-- What fills the app's fixed 64 MiB pool, reported when it takes a new
         segment. Polled from the idle loop, never from the allocator. -->
    <Compile Include="$(MSBuildThisFileDirectory)AppHeapCensus.cs"        Link="sdk\AppHeapCensus.cs" />
    <!-- Key-to-frame time, measured at the main loop's own boundaries. The
         profiler cannot answer this one: a loop waiting for input is idle. -->
    <Compile Include="$(MSBuildThisFileDirectory)UiLatency.cs"            Link="sdk\UiLatency.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ByRefAssignRefStub.cs" Link="sdk\ByRefAssignRefStub.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AtomicStub.cs" Link="sdk\AtomicStub.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)InterfaceDispatchTrampoline.cs" Link="sdk\InterfaceDispatchTrampoline.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)StackProbeStub.cs"       Link="sdk\StackProbeStub.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ThrowExTrampoline.cs"          Link="sdk\ThrowExTrampoline.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RethrowTrampoline.cs"          Link="sdk\RethrowTrampoline.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AppHost.cs"              Link="sdk\AppHost.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)StringAlgorithms.cs"     Link="sdk\StringAlgorithms.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)KeyInfo.cs"              Link="sdk\KeyInfo.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)FileEntry.cs"            Link="sdk\FileEntry.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)SystemConsole.cs"        Link="sdk\SystemConsole.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)FileSystem.AppHost.cs"   Link="sdk\FileSystem.AppHost.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ProcessStub.cs"          Link="sdk\ProcessStub.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Process.cs"              Link="sdk\Process.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Stopwatch.AppStub.cs"    Link="sdk\Stopwatch.AppStub.cs" />

    <!-- Internal.Runtime.CompilerHelpers.ThrowHelpers is the copy inside
         sdk/MinimalRuntime.cs: ILC resolves the type by fixed name, so there is
         exactly one per image. The kernel has its own in
         OS/src/Boot/ThrowHelpers.cs.

         Ярусные пары std переехали в std-no-runtime/README.md — здесь их
         перечисление было второй копией, и она уже начала расходиться. -->
    <!-- What ILC's `ldtoken` lowering looks up by name in the system module —
         which for a freestanding app is the app. Needed since apps started
         using `typeof`, by way of record types. System.Type itself lives in
         MinimalRuntime.cs beside the other core types. -->
    <Compile Include="$(MSBuildThisFileDirectory)LdTokenHelpers.cs"        Link="sdk\LdTokenHelpers.cs" />
    <!-- Marker types the compiler looks up by name. Without IsExternalInit an
         `init` accessor — and therefore every `record` — fails to compile;
         apps did without it until one of them vendored a library built out of
         records. -->
    <!-- Keys are held strongly, not weakly: no weak handles in either
         collector. See the file's header and limits §8. -->

    <!-- Tasks: shared surface plus the app's thread backend (service table V3).
         Terminal.Gui keeps input decoding and the resize watch on background
         loops, so without threads it does not run slowly — it does not run. -->
    <!-- Declared for BCL-shaped parse calls; the values are real, nothing
         honours them. See the file header. -->
  </ItemGroup>

  <!-- Freestanding CRT stubs (__security_cookie via CoffStub.Generator,
       __security_check_cookie / __managed__Startup no-ops) + the freestanding
       linker recipe. win-x64 only; the CoffStub .targets is imported only here
       so the [CoffDataSymbol] attribute is compiled for exactly this build. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Compile Include="$(MSBuildThisFileDirectory)WinCrtStubs.cs" Link="sdk\WinCrtStubs.cs" />
    <LinkerArg Include="/ENTRY:SharpAppBootstrap" />
    <LinkerArg Include="/SUBSYSTEM:NATIVE" />
    <!-- The preferred base is the first process slot, 0x2000_0000_0000
         (32 TiB, AppProcesses.ImageRegionBase): beyond any RAM the kernel maps
         one to one. Not /FIXED (step194): the loader gives every process a
         range of its own in the one address space and relocates the image
         there. The map-over of [base, base+SizeOfImage) must never meet the
         kernel's identity-mapped RAM: at 0x400000 a bss-fattened image
         swallowed the kernel heap (step142); at 0x100000000 a 7 GiB laptop
         had the kernel image itself at 0x1_4000_0000 (step194). -->
    <LinkerArg Include="/BASE:0x200000000000" />
    <LinkerArg Include="/DYNAMICBASE:NO" />
    <LinkerArg Include="/NODEFAULTLIB" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)SharpAppManifest.props" />

  <Import Project="$(MSBuildThisFileDirectory)..\..\generators\CoffStub.Generator\CoffStub.Generator.targets"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and Exists('$(MSBuildThisFileDirectory)..\..\generators\CoffStub.Generator\CoffStub.Generator.targets')" />

  <!-- Drop the resilient ILC flag (mirrors OS.csproj DropResilient, step142).
       Resilient mode makes ILC silently emit fallback stubs for cctor checks
       instead of routing them through the managed ClassConstructorRunner the
       app now compiles (std/Runtime/ClassConstructorRunner.cs) — the stubs
       #GP with a 0xF000... sentinel on the first `static readonly` touch.
       Combined with GcStaticsInit (app-side GCStaticRegion materialization in
       AppRuntime.Initialize) this makes lazy static patterns work in apps,
       same as the kernel (limits doc §1). -->
  <Target Name="DropResilient" AfterTargets="WriteIlcRspFileForCompilation" BeforeTargets="IlcCompile">
    <ItemGroup>
      <IlcArg Remove="--resilient" />
    </ItemGroup>
    <WriteLinesToFile File="%(ManagedBinary.IlcRspFile)" Lines="@(IlcArg)" Overwrite="true" />
  </Target>

  <!-- net8/ILC8 links the SDK NativeAOT runtime (Runtime.WorkstationGC /
       Runtime.VxsortEnabled) + wmain bootstrapper by default. The app ships its
       own freestanding runtime (std GC + [RuntimeExport] helpers) and enters via
       SharpAppBootstrap, so linking the SDK runtime double-defines helpers and
       drags in a CRT cascade. Drop them from BOTH NativeLibrary and LinkerArg
       (Windows.targets snapshots NativeLibrary into LinkerArg in
       SetupOSSpecificProps before this Target). Mirrors OS.csproj. -->
  <Target Name="ExcludeNativeAotRuntime"
          AfterTargets="SetupOSSpecificProps" BeforeTargets="LinkNative"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <NativeLibrary Remove="$(IlcSdkPath)Runtime.WorkstationGC$(LibrarySuffix)" />
      <LinkerArg Remove="&quot;$(IlcSdkPath)Runtime.WorkstationGC$(LibrarySuffix)&quot;" />
      <NativeLibrary Remove="$(IlcSdkPath)Runtime.VxsortEnabled$(LibrarySuffix)" />
      <LinkerArg Remove="&quot;$(IlcSdkPath)Runtime.VxsortEnabled$(LibrarySuffix)&quot;" />
      <NativeLibrary Remove="$(IlcSdkPath)bootstrapper$(ObjectSuffix)" />
      <LinkerArg Remove="&quot;$(IlcSdkPath)bootstrapper$(ObjectSuffix)&quot;" />
    </ItemGroup>
  </Target>

  <!-- Build id, same shape as the kernel's (OS.csproj GenerateBuildInfo) and
       fed by the same helper: build.ps1 passes /p:BuildId=sha[+dirty][-tag].
       Every app carries its own, because the kernel's WriteBuildId service
       reports the KERNEL's id, and an app built three days earlier reported it
       just as confidently. That is how the rig spent an evening running a
       stale launcher against a fresh kernel. AppRuntime.Initialize prints this
       one, so the first line an app writes says what it is.
       NOTE: $(IntermediateOutputPath) is only set after SDK init, so compute
       the path INSIDE the target. -->
  <PropertyGroup>
    <BuildId Condition="'$(BuildId)' == ''">local</BuildId>
  </PropertyGroup>

  <Target Name="GenerateAppBuildInfo" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <AppBuildInfoGeneratedFile>$(IntermediateOutputPath)AppBuildInfo.g.cs</AppBuildInfoGeneratedFile>
      <AppBuildInfoFileContents>namespace SharpOS.AppSdk%0A{%0A    internal static class AppBuildInfo%0A    {%0A        internal const string Id = "$(BuildId)"%3B%0A        internal const string Name = "$(AssemblyName)"%3B%0A    }%0A}%0A</AppBuildInfoFileContents>
    </PropertyGroup>
    <WriteLinesToFile File="$(AppBuildInfoGeneratedFile)" Lines="$(AppBuildInfoFileContents)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(AppBuildInfoGeneratedFile)" />
      <FileWrites Include="$(AppBuildInfoGeneratedFile)" />
    </ItemGroup>
  </Target>

  <!-- Strip ref-assembly + host-config plumbing the SDK adds (freestanding, no
       host). Shared by all apps. -->
  <Target Name="CustomizeReferences" BeforeTargets="BeforeCompile" AfterTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" />
      <ReferencePath Remove="@(ReferencePath)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveHostConfigurationOptions" BeforeTargets="WriteIlcRspFileForCompilation" DependsOnTargets="PrepareForILLink">
    <ItemGroup>
      <RuntimeHostConfigurationOption Remove="@(RuntimeHostConfigurationOption)" />
    </ItemGroup>
  </Target>

</Project>
