<Project>

  <!-- Сшивание PE через lld-link + xwin из тулчейна SharpOS, на любом хосте. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\SharpOsNativeLink.props" />

  <!-- Shared freestanding win-x64 PE recipe for SharpOS native apps (step138).
       Imported by each app csproj (HelloSharpFs, FetchApp, AotTests, ...). Turns
       `dotnet publish -r win-x64` into a self-contained PE the kernel's PeLoader
       maps + jumps (see done/step137.md). ELF (linux-x64) builds are gone; this
       is win-x64 only, gated on the RID so a non-win-x64 evaluation is a no-op.

       The app csproj keeps only what differs: its own Program.cs and
       app-specific sources. The system module is System.Private.CoreLib for
       every app (std-no-runtime/CoreLib.App), set below. -->

  <PropertyGroup>
    <!-- net8/ILC8 (matches the kernel / major-9 GC layout). -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <!-- The kernel's language version. net8 would otherwise default apps to
         C# 12 while the std they compile is written against 14, and code
         generated for every image (generators/ImageInfo.Generator, generators/Pipes.Generator) has to
         compile in both. -->
    <LangVersion Condition="'$(LangVersion)' == ''">14.0</LangVersion>
    <!-- Unconditional: Sdk.props already defaulted OutputType to Library before
         this import, so a `== ''` guard would leave it Library and NativeAOT
         would link bootstrapperdll.obj (the DLL runtime bootstrap) which our
         ExcludeNativeAotRuntime (bootstrapper.obj, the EXE one) doesn't strip. -->
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- As the kernel: std is ported BCL and carries `T?` throughout; without
         a nullable context every one of them is a CS8632 (≈2000 an app). -->
    <Nullable Condition="'$(Nullable)' == ''">annotations</Nullable>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <RuntimeMetadataVersion>v4.0.30319</RuntimeMetadataVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PublishAot>true</PublishAot>
    <!-- PublishAot turns on the SDK's trim/AOT/single-file analyzers. They
         warn about reflection, which this tier does not have at all, and their
         per-method dataflow is quadratic in locals: AotTests' generated
         GcBigFrame (4400 locals) took csc past 20 GB (step198). Off. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <!-- And ILC's own trim/AOT dataflow warnings (IL2026, IL3050, IL2104,
         IL3053), which it reports since CoreLib is a real
         System.Private.CoreLib and reflection metadata is on (step252): they
         are about reflection invoke and runtime code generation, which this
         runtime has neither of. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <SuppressAotAnalysisWarnings>true</SuppressAotAnalysisWarnings>
    <EntryPointSymbol>SharpAppEntry</EntryPointSymbol>

    <!-- net8/ILC8: DebuggerSupport (default on) exports DotNetRuntimeDebugHeader
         (unresolved / LNK1294); no debugger attaches to a freestanding app.
         IlcDehydrate (default on) compresses data + relies on the stock
         bootstrapper to rehydrate at startup, which we exclude below, so bake
         data in directly, else string literals read back as zeros. -->
    <DebuggerSupport>false</DebuggerSupport>
    <IlcDehydrate>false</IlcDehydrate>
  </PropertyGroup>

  <!-- An app is built over System.Private.CoreLib for apps — std, its app tier
       and the SDK's runtime half (std-no-runtime/CoreLib.App) — and over the
       SDK library (SharpOS.AppSdk.csproj), as a stock program over the stock
       CoreLib and its libraries. Both are compiled once for every app. The
       generators run over the app's own code. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\std-no-runtime\Generators.props" />
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\std-no-runtime\CoreLib.App\CoreLib.App.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)SharpOS.AppSdk.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Set, not left empty: empty would add the stock AutoInitializedAssemblies
         (TypeLoader, Reflection.Execution…) this runtime does not have. -->
    <IlcSystemModule>System.Private.CoreLib</IlcSystemModule>
  </PropertyGroup>
  <ItemGroup>
    <UnmanagedEntryPointsAssembly Include="System.Private.CoreLib" />
  </ItemGroup>

  <!-- Freestanding CRT stubs (__security_cookie via CoffStub.Generator,
       __security_check_cookie / __managed__Startup no-ops) + the freestanding
       linker recipe. win-x64 only; the CoffStub .targets is imported only here
       so the [CoffDataSymbol] attribute is compiled for exactly this build. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Compile Include="$(MSBuildThisFileDirectory)WinCrtStubs.cs" Link="sdk\WinCrtStubs.cs" />
    <LinkerArg Include="/ENTRY:SharpAppBootstrap" />
    <LinkerArg Include="/SUBSYSTEM:NATIVE" />
    <!-- The preferred base is the first process slot, 0x2000_0000_0000
         (32 TiB, AppProcesses.ImageRegionBase): beyond any RAM the kernel maps
         one to one. Not /FIXED (step194): the loader gives every process a
         range of its own in the one address space and relocates the image
         there. The map-over of [base, base+SizeOfImage) must never meet the
         kernel's identity-mapped RAM: at 0x400000 a bss-fattened image
         swallowed the kernel heap (step142); at 0x100000000 a 7 GiB laptop
         had the kernel image itself at 0x1_4000_0000 (step194). -->
    <LinkerArg Include="/BASE:0x200000000000" />
    <LinkerArg Include="/DYNAMICBASE:NO" />
    <LinkerArg Include="/NODEFAULTLIB" />
    <!-- g_cpuFeatures (WinCrtStubs), exported so AppRuntime can find it in its
         own image and write the CPU's flags into it before any code reads them. -->
    <LinkerArg Include="/EXPORT:g_cpuFeatures,DATA" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)SharpAppManifest.props" />

  <Import Project="$(MSBuildThisFileDirectory)..\..\generators\CoffStub.Generator\CoffStub.Generator.targets"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and Exists('$(MSBuildThisFileDirectory)..\..\generators\CoffStub.Generator\CoffStub.Generator.targets')" />

  <!-- Drop the resilient ILC flag (mirrors OS.csproj DropResilient, step142).
       Resilient mode makes ILC silently emit fallback stubs for cctor checks
       instead of routing them through the managed ClassConstructorRunner the
       app now compiles (std/Runtime/ClassConstructorRunner.cs) — the stubs
       #GP with a 0xF000... sentinel on the first `static readonly` touch.
       Combined with GcStaticsInit (app-side GCStaticRegion materialization in
       AppRuntime.Initialize) this makes lazy static patterns work in apps,
       same as the kernel (limits doc §1). -->
  <!-- -noinlinetls: [ThreadStatic] through Internal.Runtime.ThreadStatics
       (std), not the image's native TLS (.tls, _tls_index), which an app
       image does not have (step209). -->
  <Target Name="DropResilient" AfterTargets="WriteIlcRspFileForCompilation" BeforeTargets="IlcCompile">
    <ItemGroup>
      <IlcArg Remove="--resilient" />
      <IlcArg Include="--noinlinetls" />
    </ItemGroup>
    <WriteLinesToFile File="%(ManagedBinary.IlcRspFile)" Lines="@(IlcArg)" Overwrite="true" />
  </Target>

  <!-- net8/ILC8 links the SDK NativeAOT runtime (Runtime.WorkstationGC /
       Runtime.VxsortEnabled) + wmain bootstrapper by default. The app ships its
       own freestanding runtime (std GC + [RuntimeExport] helpers) and enters via
       SharpAppBootstrap, so linking the SDK runtime double-defines helpers and
       drags in a CRT cascade. Drop them from BOTH NativeLibrary and LinkerArg
       (Windows.targets snapshots NativeLibrary into LinkerArg in
       SetupOSSpecificProps before this Target). Mirrors OS.csproj. -->
  <Target Name="ExcludeNativeAotRuntime"
          AfterTargets="SetupOSSpecificProps" BeforeTargets="LinkNative"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <NativeLibrary Remove="$(IlcSdkPath)Runtime.WorkstationGC$(LibrarySuffix)" />
      <LinkerArg Remove="&quot;$(IlcSdkPath)Runtime.WorkstationGC$(LibrarySuffix)&quot;" />
      <NativeLibrary Remove="$(IlcSdkPath)Runtime.VxsortEnabled$(LibrarySuffix)" />
      <LinkerArg Remove="&quot;$(IlcSdkPath)Runtime.VxsortEnabled$(LibrarySuffix)&quot;" />
      <NativeLibrary Remove="$(IlcSdkPath)bootstrapper$(ObjectSuffix)" />
      <LinkerArg Remove="&quot;$(IlcSdkPath)bootstrapper$(ObjectSuffix)&quot;" />
    </ItemGroup>
  </Target>

  <!-- Build id, fed by the same helper as the kernel's: build.ps1 passes
       /p:BuildId=sha[+dirty][-tag]. Every app carries its own, because the
       kernel's WriteBuildId service reports the KERNEL's id, and an app built
       three days earlier reported it just as confidently. That is how the rig
       spent an evening running a stale launcher against a fresh kernel.
       ImageInfo.Generator writes it into SharpOS.Generated.ImageInfo and hands
       it, with the name, to AppRuntime from a module initializer; the banner
       prints it, so the first line an app writes says what it is. -->
  <PropertyGroup>
    <BuildId Condition="'$(BuildId)' == ''">local</BuildId>
    <SharpOsImageKind>App</SharpOsImageKind>
  </PropertyGroup>

  <!-- The framework's assemblies, before references are resolved: the targeting
       pack's System.Text.Json, RegularExpressions… would otherwise contend with
       ours (MSB3243) — the SDK resolves the conflict before
       CustomizeReferences below drops them. -->
  <Target Name="DropFrameworkReferences" AfterTargets="ResolveTargetingPackAssets" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.FrameworkReferenceName)' != ''" />
    </ItemGroup>
  </Target>

  <!-- Strip ref-assembly + host-config plumbing the SDK adds (freestanding, no
       host); our CoreLib and SDK (project references) stay. Shared by all apps. -->
  <Target Name="CustomizeReferences" BeforeTargets="BeforeCompile" AfterTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" Condition="'%(ReferencePathWithRefAssemblies.ReferenceSourceTarget)' != 'ProjectReference'" />
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' != 'ProjectReference'" />
    </ItemGroup>
  </Target>

  <!-- ILC: our CoreLib and SDK instead of the stock CoreLib and framework the
       targets hand it (-r:). -->
  <Target Name="UseSharpOsCoreLib" AfterTargets="ComputeIlcCompileInputs" BeforeTargets="WriteIlcRspFileForCompilation">
    <ItemGroup>
      <IlcReference Remove="@(IlcReference)" />
      <IlcReference Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveHostConfigurationOptions" BeforeTargets="WriteIlcRspFileForCompilation" DependsOnTargets="PrepareForILLink">
    <ItemGroup>
      <RuntimeHostConfigurationOption Remove="@(RuntimeHostConfigurationOption)" />
    </ItemGroup>
  </Target>

</Project>
