<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IlcSystemModule>ConvertApp</IlcSystemModule>
  </PropertyGroup>

  <!-- The freestanding win-x64 PE recipe every AOT app uses. -->
  <Import Project="..\sdk\FreestandingPe.props" />
  <!-- Utf8JsonReader / Utf8JsonWriter (vendored System.Text.Json). -->
  <Import Project="..\..\vendor\SystemTextJson\SystemTextJson.props" />

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="IConverter.cs" />
    <Compile Include="..\PipeGen\StressArgs.cs" />
    <!-- One file per conversion: Converters\FromJson.cs holds class FromJson. -->
    <Converter Include="Converters\*.cs" />
    <Compile Include="@(Converter)" />
    <Compile Include="$(IntermediateOutputPath)Converters.g.cs" />
  </ItemGroup>

  <!-- The registry: a `new X()` for every Converters\X.cs, so a new
       conversion is one new file and nothing else (no reflection here). -->
  <Target Name="WriteConverterRegistry" BeforeTargets="CoreCompile;BeforeBuild">
    <ItemGroup>
      <ConverterNew Include="@(Converter->'            new %(Filename)(),')" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)Converters.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated from Converters\*.cs by ConvertApp.csproj.;namespace PipeApps%3B;internal static partial class Registry;{;    internal static IConverter[] All => new IConverter[];    {;@(ConverterNew);    }%3B;}" />
  </Target>
</Project>
